<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Varian GELAP: kunci yang SAMA PERSIS dengan Colors.axaml (Terang). Digabung MENIMPA Colors.axaml lewat
    App.axaml.cs (ditambahkan ke Application.Resources.MergedDictionaries setelah XAML utama selesai
    dimuat) kalau AppPreferences.Theme = Dark, supaya key yang sama di dictionary yang datang belakangan
    menang; semantik "last one wins" biasa pada MergedDictionaries, bukan fitur ThemeVariant Avalonia.
  -->

  <Color x:Key="Color.Sidebar">#0F1826</Color>
  <Color x:Key="Color.SidebarActive">#223252</Color>
  <Color x:Key="Color.Background">#15171C</Color>
  <Color x:Key="Color.Surface">#1E2129</Color>
  <Color x:Key="Color.Border">#333743</Color>
  <Color x:Key="Color.TextPrimary">#E8EAED</Color>
  <Color x:Key="Color.TextSecondary">#9AA1AC</Color>
  <Color x:Key="Color.TextOnSidebar">#E7ECF5</Color>
  <Color x:Key="Color.TextOnSidebarMuted">#8996AF</Color>
  <Color x:Key="Color.Accent">#5B82FF</Color>
  <Color x:Key="Color.AccentHover">#7B9AFF</Color>
  <Color x:Key="Color.AccentSoft">#1E2A4D</Color>
  <Color x:Key="Color.Danger">#E5564D</Color>
  <Color x:Key="Color.DangerHover">#F0766E</Color>
  <Color x:Key="Color.DangerSoft">#3A2120</Color>
  <Color x:Key="Color.Success">#3FB877</Color>
  <Color x:Key="Color.SuccessSoft">#1B3327</Color>
  <Color x:Key="Color.Warning">#D9A03D</Color>
  <Color x:Key="Color.WarningSoft">#3A2F18</Color>
  <Color x:Key="Color.Neutral">#7C8492</Color>

  <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />
  <SolidColorBrush x:Key="Brush.SidebarActive" Color="{StaticResource Color.SidebarActive}" />
  <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
  <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
  <SolidColorBrush x:Key="Brush.TextOnSidebar" Color="{StaticResource Color.TextOnSidebar}" />
  <SolidColorBrush x:Key="Brush.TextOnSidebarMuted" Color="{StaticResource Color.TextOnSidebarMuted}" />
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
  <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
  <SolidColorBrush x:Key="Brush.DangerHover" Color="{StaticResource Color.DangerHover}" />
  <SolidColorBrush x:Key="Brush.DangerSoft" Color="{StaticResource Color.DangerSoft}" />
  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
  <SolidColorBrush x:Key="Brush.SuccessSoft" Color="{StaticResource Color.SuccessSoft}" />
  <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
  <SolidColorBrush x:Key="Brush.WarningSoft" Color="{StaticResource Color.WarningSoft}" />
  <SolidColorBrush x:Key="Brush.Neutral" Color="{StaticResource Color.Neutral}" />
</ResourceDictionary>

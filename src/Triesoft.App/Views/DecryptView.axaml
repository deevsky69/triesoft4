<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Triesoft.App.ViewModels"
             xmlns:views="clr-namespace:Triesoft.App.Views"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             x:Class="Triesoft.App.Views.DecryptView"
             x:DataType="vm:DecryptViewModel">
    <Border x:Name="DropZone" Classes="card" MaxWidth="760" HorizontalAlignment="Left">
        <StackPanel Spacing="16">
            <TextBlock Classes="body" TextWrapping="Wrap"
                       Text="Tambahkan file .ts4 yang akan didekripsi. Tiap file kembali ke nama aslinya di folder yang sama, dan kunci yang cocok dicari otomatis. File bundle otomatis dikenali dan isinya dikeluarkan ke folder baru." />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Tambah File..." Classes="secondary" Click="OnAddFilesClick" IsEnabled="{Binding !IsBusy}" />
                <Button Content="Tambah Folder..." Classes="secondary" Click="OnAddFolderClick" IsEnabled="{Binding !IsBusy}" />
                <Button Content="Kosongkan" Classes="secondary" Command="{Binding ClearFilesCommand}"
                        IsVisible="{Binding HasFiles}" IsEnabled="{Binding !IsBusy}" />
            </StackPanel>

            <CheckBox IsChecked="{Binding IncludeSubfolders}" IsEnabled="{Binding !IsBusy}"
                      Content="Sertakan subfolder saat menambah folder" />

            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="Atau seret file .ts4 dan folder dari File Explorer ke sini. Dari folder, file tersembunyi dan tautan (symlink) dilewati." />

            <TextBlock Text="{Binding FileCountText}" Classes="caption" />

            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="12,0"
                    IsVisible="{Binding HasFiles}">
                <ScrollViewer MaxHeight="340">
                    <ItemsControl ItemsSource="{Binding Files}" Margin="0,0,14,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:BatchFileItem">
                                <views:BatchFileRow />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="1" IsVisible="{Binding IsBusy}" />

            <TextBlock Text="{Binding ErrorMessage}" Classes="error-text" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding SuccessMessage}" Classes="success-text" TextWrapping="Wrap"
                       IsVisible="{Binding SuccessMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Dekripsi Semua" Classes="primary" Command="{Binding DecryptCommand}" />
                <Button Content="Batal" Classes="secondary" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

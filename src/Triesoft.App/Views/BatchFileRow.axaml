<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Triesoft.App.ViewModels"
             x:Class="Triesoft.App.Views.BatchFileRow"
             x:DataType="vm:BatchFileItem">
    <Grid ColumnDefinitions="Auto,*,110,Auto" ColumnSpacing="12" Margin="0,8">
        <Ellipse Grid.Column="0" Classes="status-dot"
                 Fill="{Binding Status, Converter={StaticResource BatchStatusToBrushConverter}}"
                 VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding DisplayName}" Classes="body" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Directory}" Classes="caption" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding ShowDirectory}" />
            <TextBlock Text="{Binding ResultText}" Classes="caption" TextWrapping="Wrap"
                       Foreground="{Binding Status, Converter={StaticResource BatchStatusToBrushConverter}}"
                       IsVisible="{Binding ShowResult}" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding StatusText}" Classes="secondary" VerticalAlignment="Center" />
        <Button Grid.Column="3" Content="Hapus" Classes="secondary" Command="{Binding RemoveCommand}"
                IsVisible="{Binding IsRemovable}" VerticalAlignment="Center" />
    </Grid>
</UserControl>

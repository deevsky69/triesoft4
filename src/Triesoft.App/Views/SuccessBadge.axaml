<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Triesoft.App.Views.SuccessBadge"
             Width="22" Height="22">
    <Panel>
        <Ellipse Fill="{StaticResource Brush.SuccessSoft}" Width="22" Height="22" />
        <Path Data="M5,11 L9,15 L17,5" Stroke="{StaticResource Brush.Success}" StrokeThickness="2.4"
              StrokeLineCap="Round" StrokeJoin="Round" />
    </Panel>
</UserControl>

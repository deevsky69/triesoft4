<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Triesoft.App.ViewModels"
             xmlns:views="clr-namespace:Triesoft.App.Views"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             x:Class="Triesoft.App.Views.EncryptView"
             x:DataType="vm:EncryptViewModel">
    <Border x:Name="DropZone" Classes="card" MaxWidth="760" HorizontalAlignment="Left">
        <StackPanel Spacing="16">
            <TextBlock Classes="body" TextWrapping="Wrap"
                       Text="Tambahkan file yang akan dienkripsi (PDF, Word, PPT, gambar, dll). Bawaannya tiap file menjadi file .ts4 sendiri; centang opsi bundle di bawah untuk menggabungkan semuanya menjadi satu file .ts4." />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Tambah File..." Classes="secondary" Click="OnAddFilesClick" IsEnabled="{Binding !IsBusy}" />
                <Button Content="Tambah Folder..." Classes="secondary" Click="OnAddFolderClick" IsEnabled="{Binding !IsBusy}" />
                <Button Content="Kosongkan" Classes="secondary" Command="{Binding ClearFilesCommand}"
                        IsVisible="{Binding HasFiles}" IsEnabled="{Binding !IsBusy}" />
            </StackPanel>

            <CheckBox IsChecked="{Binding IncludeSubfolders}" IsEnabled="{Binding !IsBusy}"
                      Content="Sertakan subfolder saat menambah folder" />

            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="Atau seret file dan folder dari File Explorer ke sini. Dari folder, file tersembunyi, file sistem, tautan (symlink), dan folder kosong dilewati." />

            <CheckBox IsChecked="{Binding BundleMode}" IsEnabled="{Binding !IsBusy}"
                      Content="Gabungkan semua file menjadi satu file .ts4 (bundle)" />

            <StackPanel Spacing="10" IsVisible="{Binding BundleMode}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Nama bundle" Classes="caption" />
                    <TextBox Text="{Binding BundleName}" IsEnabled="{Binding !IsBusy}" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="Simpan di folder" Classes="caption" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Text="{Binding EffectiveBundleFolder, Mode=OneWay}" IsReadOnly="True"
                                 PlaceholderText="Folder file pertama di daftar" />
                        <Button Grid.Column="1" Content="Pilih Folder..." Classes="secondary" Click="OnPickBundleFolderClick"
                                IsEnabled="{Binding !IsBusy}" />
                    </Grid>
                </StackPanel>
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="Semua file masuk ke satu file terenkripsi, dengan struktur subfolder dari folder yang Anda tambahkan. Kalau ada satu file yang tidak bisa dibaca, bundle tidak dibuat sama sekali. Saat didekripsi, isinya keluar di folder baru bernama sama dengan bundle." />
            </StackPanel>

            <TextBlock Text="{Binding FileCountText}" Classes="caption" />

            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="12,0"
                    IsVisible="{Binding HasFiles}">
                <ScrollViewer MaxHeight="340">
                    <ItemsControl ItemsSource="{Binding Files}" Margin="0,0,14,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:BatchFileItem">
                                <views:BatchFileRow />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="1" IsVisible="{Binding IsBusy}" />

            <TextBlock Text="{Binding ErrorMessage}" Classes="error-text" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding SuccessMessage}" Classes="success-text" TextWrapping="Wrap"
                       IsVisible="{Binding SuccessMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding RunButtonText}" Classes="primary" Command="{Binding EncryptCommand}" />
                <Button Content="Batal" Classes="secondary" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

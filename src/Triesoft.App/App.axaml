<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Triesoft.App.Converters"
             xmlns:vm="clr-namespace:Triesoft.App.ViewModels"
             xmlns:views="clr-namespace:Triesoft.App.Views"
             x:Class="Triesoft.App.App">

    <Application.DataTemplates>
        <DataTemplate DataType="vm:LoginViewModel">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="vm:FirstRunSetupViewModel">
            <views:FirstRunSetupView />
        </DataTemplate>
        <DataTemplate DataType="vm:MainShellViewModel">
            <views:MainShellView />
        </DataTemplate>
    </Application.DataTemplates>

    <!--
        TIDAK ADA elemen Application.Resources di sini SENGAJA. App() (App.axaml.cs) membangun seluruh
        Resources (converter + warna) lewat kode, di constructor, sebelum Initialize()/AvaloniaXamlLoader
        memparse Application.Styles di bawah (yang me-resolve StaticResource Brush.* begitu pertama kali
        dipakai). Kalau elemen Application.Resources ada di XAML ini, memparsenya (bagian dari Initialize()
        yang sama) MENIMPA seluruh objek Resources, termasuk yang sudah diisi lewat kode di constructor,
        sehingga warna yang sudah dimuat lenyap lagi sebelum sempat dipakai style. Lihat juga catatan
        panjang soal ini di App.axaml.cs dan AppPreferences.
    -->

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Triesoft.App/Theme/Typography.axaml" />
        <StyleInclude Source="avares://Triesoft.App/Theme/Controls.axaml" />
    </Application.Styles>
</Application>
